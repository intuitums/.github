# /etc/systemd/system/actions.slice
# The real ceiling for the whole runner fleet.
#
# Per-runner fleet.conf drop-ins deliberately oversubscribe the host —
# 2x2 + 3x4 + 8 + 8 + 24 = 56 vcpu of label promise against 24 physical
# threads — so that a job which is not competing actually gets the size its
# label promises. This slice is what stops that arithmetic from mattering:
# the fleet as a whole can never exceed 22 of 24 cores or 26 of 30 GB,
# leaving the host a reserve it cannot be starved out of.
[Unit]
Description=Resource envelope for Intuitum GitHub Actions

[Slice]
CPUQuota=2200%
MemoryHigh=22G
MemoryMax=26G
TasksMax=24576
